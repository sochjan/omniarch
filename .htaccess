Options -Indexes

ErrorDocument 404 /omniarch-web/404.html

RewriteEngine On
RewriteBase /omniarch-web/

# Redirect missing files/dirs with no trailing slash → add trailing slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+[^/])$ /omniarch-web/$1/ [R=301,L]
